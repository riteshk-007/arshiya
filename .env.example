# House of Arshiya: environment variables
# Copy to .env.local for local work. On the host (Vercel, etc.) add the same names in its settings.
# Never commit real values.

# --- Public website address (links in emails, sitemap, share previews)
NEXT_PUBLIC_SITE_URL=https://www.arshiya.uk

# --- Database (Neon Postgres, via Prisma)
# Pooled connection used by the app
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct connection (no "-pooler") used by `npm run db:push`, with the same schema name as below
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&schema=arshiya
# Keeps this app's tables apart from anything else in the same database
PRISMA_SCHEMA=arshiya

# --- Admin
# Used once by `npm run db:seed` to create the first admin. Change the password in Admin > Settings afterwards.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random text. Used to hash visitor IP addresses (never stored in plain form).
IP_HASH_SALT=

# --- Cloudflare R2 (enquiry attachments: images and PDFs)
# Cloudflare dashboard > R2: create a private bucket, then an API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Journal images live in a SECOND bucket that is public (visitors load them). Keep it separate from the private one above.
# Cloudflare R2: create the bucket, then turn on "Public access" (r2.dev link) or connect a custom domain such as cdn.arshiya.uk.
R2_PUBLIC_BUCKET=
# The public address of that bucket with no trailing slash, e.g. https://cdn.arshiya.uk
R2_PUBLIC_URL=
# Optional: only for EU jurisdiction buckets or testing, e.g. https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Brevo (emails the team when an enquiry arrives)
# Brevo > SMTP & API > the "API Keys" tab (NOT the "SMTP" tab). It starts with xkeysib-. A key starting with xsmtpsib- is an SMTP key and will be refused (401).
# The sender must be a verified sender or authenticated domain in Brevo; a sender on your own domain (info@arshiya.uk) reaches inboxes far more reliably than a Gmail address.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=House of Arshiya Website
# Who receives the notifications: every team address, separated by commas. Each enquiry goes to the matching inbox:
#   an address containing "couture"  -> couture, collaboration, accessories, half-scale and sampling enquiries
#   an address containing "bridal"   -> bridal embroidery enquiries
#   an address containing "sales" / "info" / "general" / "business" -> enquiries with no category chosen
# If nothing matches, the enquiry goes to every address, so nothing is lost.
ADMIN_NOTIFY_EMAIL=hautecouture@arshiya.uk,bridal@arshiya.uk,sales@arshiya.uk
# Optional: set a route explicitly instead of relying on the address names above.
NOTIFY_EMAIL_COUTURE=
NOTIFY_EMAIL_BRIDAL=
NOTIFY_EMAIL_GENERAL=
